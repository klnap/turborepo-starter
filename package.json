{
  "name": "turborepo-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "^24.0.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "preinstall": "bun ./scripts/audit/check-package-manager.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "cli": "bun run scripts/cli/index.ts",
    "turbo": "turbo",
    "root": "bun scripts/cli/entries/root.ts",
    "ws": "bun scripts/cli/entries/workspace.ts",
    "pkg": "bun scripts/cli/entries/package.ts",
    "adopt": "bun scripts/cli/entries/adopt.ts",
    "lint": "biome check .",
    "lint:code": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --write --staged --no-errors-on-unmatched",
    "lint:code:fix": "biome check --write .",
    "lint:oxlint": "oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "lint:i18n": "turbo run lint:i18n",
    "lint:deps": "bun scripts/audit/dependency-ownership.ts",
    "lint:env": "bun run scripts/audit/env.ts",
    "lint:architecture": "turbo run lint:architecture",
    "boundaries": "turbo run lint:architecture",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "turbo run test",
    "test:cli": "bun test scripts/cli",
    "gitleaks:staged": "bun scripts/git/gitleaks-cli.ts staged",
    "gitleaks:scan": "bun scripts/git/gitleaks-cli.ts workdir",
    "check:dead-code": "turbo run knip",
    "security:audit": "bun audit --ignore GHSA-848j-6mx2-7j84 --ignore GHSA-jmr9-qjv8-65gv --ignore GHSA-5p2g-fcmc-qvqq --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-2883-xcg3-v3hh",
    "knip": "turbo run knip",
    "licenses": "license-checker --summary --excludePrivatePackages --failOn 'GPL;AGPL'",
    "gate:quick": "bun run scripts/gate/index.ts quick",
    "gate:ci": "bun run scripts/gate/index.ts ci",
    "gate:push": "bun run scripts/gate/index.ts push",
    "gate:full": "bun run scripts/gate/index.ts full",
    "audit:env": "bun run scripts/audit/env.ts",
    "audit:repo": "bun run scripts/audit/repo-cli.ts",
    "git:pre-commit": "bun run scripts/git/pre-commit.ts",
    "git:pre-push": "bun run scripts/git/pre-push.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "docs:generate": "turbo run docs:generate",
    "clean": "turbo run clean && rm -rf node_modules",
    "secrets:login": "infisical login",
    "secrets:pull": "bun scripts/cli/entries/secrets.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.80.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.0",
    "@types/license-checker": "^25.0.6",
    "@types/node": "^26.2.0",
    "license-checker": "^25.0.1",
    "listr2": "^11.0.0",
    "oxlint": "1.80.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.2",
    "valibot": "^1.4.2",
    "@changesets/cli": "^2.27.12"
  },
  "overrides": {
    "zod-validation-error": "^4.0.2",
    "qs": "^6.15.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@payloadcms/ui": "3.88.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3"
  }
}
